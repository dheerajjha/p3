# Backend server configuration
BACKEND_URL=ws://localhost:3000/wrapper
BACKEND_API_KEY=your-backend-api-key-here

# Claude SDK configuration
# NO ANTHROPIC_API_KEY NEEDED!
# The wrapper automatically uses your existing Claude Code credentials
# from ~/.claude/credentials.json (same login as 'claude' command)

# Point to your existing project directory (where you normally use Claude Code)
# This can be the same directory where you have CLAUDE.md and your codebase
WORKSPACE_DIR=/Users/yourname/your-existing-project

# Wrapper configuration
WRAPPER_ID=wrapper-mac-01
LOG_LEVEL=INFO
